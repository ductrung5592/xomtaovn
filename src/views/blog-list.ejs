<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("partials/head") %>
</head>
<body>
<%- include("partials/header") %>

<main>
  <section class="bg-charcoal-950 text-cream-50 py-14 sm:py-20">
    <div class="container-max px-4 sm:px-6 lg:px-10 text-center">
      <span class="badge bg-gold-500/15 text-gold-400 mx-auto">Blog</span>
      <h1 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold max-w-2xl mx-auto">Kinh nghiệm mua iPhone cũ</h1>
      <p class="mt-4 text-cream-50/70 max-w-xl mx-auto">Người trong nghề nói thật: chọn máy nào, kiểm tra ra sao để mua đúng máy zin.</p>
    </div>
  </section>

  <section class="section-pad bg-cream-50">
    <div class="container-max max-w-4xl">
      <% if (posts.length === 0) { %>
        <p class="text-center text-charcoal-700">Bài viết đang được cập nhật.</p>
      <% } else { %>
        <div class="grid sm:grid-cols-2 gap-6">
          <% posts.forEach(function(post) { %>
            <article class="card p-6 flex flex-col">
              <p class="text-xs font-medium text-gold-700"><%= post.categoryLabel %> · <time datetime="<%= post.date %>"><%= formatPostDate(post.date) %></time></p>
              <h2 class="mt-3 font-display text-lg font-bold text-charcoal-950">
                <a href="/blog/<%= post.slug %>" class="hover:text-gold-700"><%= post.title %></a>
              </h2>
              <p class="mt-2 text-sm text-charcoal-700 leading-relaxed"><%= post.description %></p>
              <a href="/blog/<%= post.slug %>" class="mt-4 text-sm font-semibold text-gold-700 hover:text-gold-600" aria-label="Đọc bài: <%= post.title %>">Đọc bài</a>
            </article>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
<%- include("partials/floating-contact") %>
<%- include("partials/scripts") %>
</body>
</html>
