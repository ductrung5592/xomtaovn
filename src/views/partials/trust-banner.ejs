<section class="bg-charcoal-950 text-cream-50">
  <div class="container-max section-pad text-center">
    <span class="badge bg-gold-500/15 text-gold-400 mx-auto">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a.75.75 0 01.671.415l1.923 3.897 4.3.625a.75.75 0 01.416 1.279l-3.111 3.032.734 4.284a.75.75 0 01-1.088.79L10 13.347l-3.845 2.022a.75.75 0 01-1.088-.79l.734-4.284L2.69 7.216a.75.75 0 01.416-1.279l4.3-.625L9.329 1.415A.75.75 0 0110 1z" clip-rule="evenodd" /></svg>
      Cam kết Xóm Táo
    </span>
    <h2 class="mt-5 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold max-w-3xl mx-auto leading-tight">
      <%= siteConfig.slogan %>
    </h2>
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto text-left">
      <% siteConfig.about.commitments.forEach(function(item) { %>
        <div class="rounded-2xl border border-white/10 p-5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6 text-gold-500" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
          <p class="mt-3 text-sm text-cream-50/75 leading-relaxed"><%= item %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>
