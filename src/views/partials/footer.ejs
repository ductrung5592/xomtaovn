<footer class="bg-charcoal-950 text-cream-50/80">
  <div class="container-max px-4 sm:px-6 lg:px-10 py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
    <div>
      <span class="font-display text-xl font-extrabold text-cream-50"><%= siteConfig.shopName %></span>
      <p class="mt-3 text-sm leading-relaxed text-cream-50/60"><%= siteConfig.slogan %></p>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold text-gold-400 uppercase tracking-wider">Liên kết</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/" class="hover:text-gold-400">Trang chủ</a></li>
        <li><a href="/san-pham" class="hover:text-gold-400">Sản phẩm</a></li>
        <li><a href="/bao-hanh" class="hover:text-gold-400">Bảo hành</a></li>
        <li><a href="/gioi-thieu" class="hover:text-gold-400">Về chúng tôi</a></li>
        <li><a href="/lien-he" class="hover:text-gold-400">Liên hệ</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold text-gold-400 uppercase tracking-wider">Liên hệ</h3>
      <ul class="mt-4 space-y-2 text-sm text-cream-50/70">
        <li><%= siteConfig.address %></li>
        <li><%= siteConfig.openingHours %></li>
        <li>Hotline: <a href="tel:<%= siteConfig.contact.hotline.phone %>" class="hover:text-gold-400"><%= siteConfig.contact.hotline.phone %></a></li>
        <li>Zalo: <a href="<%= siteConfig.contact.zalo.url %>" target="_blank" rel="noopener noreferrer" class="hover:text-gold-400"><%= siteConfig.contact.zalo.phone %></a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold text-gold-400 uppercase tracking-wider">Cam kết</h3>
      <ul class="mt-4 space-y-2 text-sm text-cream-50/70">
        <% siteConfig.about.commitments.slice(0, 2).forEach(function(item) { %>
          <li class="flex gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 flex-shrink-0 text-gold-500 mt-0.5" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
            <span><%= item %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-max px-4 sm:px-6 lg:px-10 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-cream-50/40">
      <span>&copy; <%= new Date().getFullYear() %> <%= siteConfig.shopName %>. Mọi quyền được bảo lưu.</span>
      <span>Thiết kế sang trọng — chỉ bán máy zin.</span>
    </div>
  </div>
</footer>
