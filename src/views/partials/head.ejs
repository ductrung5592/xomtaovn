<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof pageTitle !== "undefined" && pageTitle ? pageTitle + " | " + siteConfig.shopName : siteConfig.shopName %></title>
<meta name="description" content="<%= siteConfig.tagline %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
  rel="stylesheet"
/>
<link rel="stylesheet" href="/css/styles.css" />
<link rel="icon" href="data:,">
<% if (!isDev && siteConfig.googleAnalyticsId) { %>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= siteConfig.googleAnalyticsId %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '<%= siteConfig.googleAnalyticsId %>');
  // Đo lượt bấm liên hệ: Gọi / Zalo / Messenger
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
    if (!a) return;
    var h = a.getAttribute('href') || '', ev = null;
    if (h.indexOf('tel:') === 0) ev = 'lien_he_goi';
    else if (h.indexOf('zalo.me') > -1) ev = 'lien_he_zalo';
    else if (h.indexOf('m.me/') > -1 || h.indexOf('messenger.com') > -1) ev = 'lien_he_messenger';
    if (ev) gtag('event', ev, { trang: location.pathname, tieu_de: document.title, transport_type: 'beacon' });
  });
</script>
<% } %>
