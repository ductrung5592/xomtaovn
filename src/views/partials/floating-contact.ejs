<div class="fixed bottom-5 right-4 sm:bottom-6 sm:right-6 z-40 flex flex-col items-end gap-3">
  <a
    href="<%= siteConfig.contact.zalo.url %>"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Nhắn tin Zalo cho Xóm Táo"
    class="group flex h-14 w-14 items-center justify-center rounded-full bg-[#0068FF] text-white shadow-lg transition-transform hover:scale-105"
  >
    <span class="font-display text-lg font-extrabold" aria-hidden="true">Z</span>
  </a>
  <a
    href="<%= siteConfig.contact.messenger.url %>"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Nhắn tin Messenger cho Xóm Táo"
    class="group flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[#00B2FF] to-[#7B2FF7] text-white shadow-lg transition-transform hover:scale-105"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 2c-4.42 0-8 3.28-8 7.33 0 2.31 1.17 4.37 3 5.72V18l2.74-1.51c.73.2 1.5.31 2.26.31 4.42 0 8-3.28 8-7.33S14.42 2 10 2zm.99 9.86l-2.04-2.18-3.98 2.18 4.38-4.65 2.09 2.18 3.93-2.18-4.38 4.65z" clip-rule="evenodd" />
    </svg>
  </a>
  <a
    href="tel:<%= siteConfig.contact.hotline.phone %>"
    aria-label="Gọi hotline Xóm Táo"
    class="group flex h-14 w-14 items-center justify-center rounded-full bg-gold-500 text-charcoal-950 shadow-gold transition-transform hover:scale-105"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6" aria-hidden="true">
      <path d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-.483 1.498l-1.11.923c-.078.065-.109.174-.061.267a11.5 11.5 0 005.516 5.516c.093.048.202.017.267-.061l.923-1.11a1.5 1.5 0 011.498-.483l3.223.716A1.5 1.5 0 0118 17.35v1.15a1.5 1.5 0 01-1.5 1.5H15c-8.284 0-15-6.716-15-15v-.5z" />
    </svg>
  </a>
</div>
