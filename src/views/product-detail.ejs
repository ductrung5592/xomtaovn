<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("partials/head") %>
</head>
<body>
<%- include("partials/header") %>

<main>
  <section class="section-pad bg-cream-50">
    <div class="container-max">
      <nav class="text-xs text-charcoal-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold-600">Trang chủ</a>
        <span aria-hidden="true"> / </span>
        <a href="/san-pham" class="hover:text-gold-600">Sản phẩm</a>
        <span aria-hidden="true"> / </span>
        <span class="text-charcoal-800"><%= product.model %></span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <div class="relative aspect-square rounded-2xl overflow-hidden bg-charcoal-950">
            <img
              id="mainProductImage"
              src="<%= product.images[0] %>"
              alt="Ảnh <%= product.model %> <%= product.storageGb %>GB <%= product.color %>"
              class="h-full w-full object-cover"
              width="600" height="600"
            />
            <% if (product.isDemo) { %>
              <span class="absolute top-4 left-4 badge bg-charcoal-950/80 text-cream-50/90">Ảnh minh hoạ</span>
            <% } %>
          </div>
          <% if (product.images.length > 1) { %>
          <div class="mt-3 flex gap-3" data-gallery-thumbs>
            <% product.images.forEach(function(src, i) { %>
              <button
                type="button"
                data-src="<%= src %>"
                class="h-16 w-16 rounded-lg overflow-hidden border-2 <%= i === 0 ? 'border-gold-500' : 'border-transparent' %>"
                aria-label="Xem ảnh <%= i + 1 %>"
              >
                <img src="<%= src %>" alt="" class="h-full w-full object-cover" />
              </button>
            <% }); %>
          </div>
          <% } %>
        </div>

        <div>
          <span class="badge <%= product.stockStatus === 'sold' ? 'bg-charcoal-900/10 text-charcoal-600' : 'bg-gold-500/15 text-gold-700' %>">
            <%= product.stockStatus === 'sold' ? 'Đã bán' : 'Còn hàng' %>
          </span>
          <h1 class="mt-3 font-display text-2xl sm:text-3xl font-extrabold text-charcoal-950"><%= product.model %></h1>
          <p class="mt-1 text-charcoal-500"><%= product.color %> · <%= product.storageGb %>GB</p>

          <p class="mt-5 font-display text-3xl font-extrabold text-gold-600"><%= formatPriceVND(product.price) %></p>

          <table class="mt-6 w-full text-sm">
            <tbody>
              <tr class="border-t border-charcoal-900/10">
                <th scope="row" class="py-3 text-left font-medium text-charcoal-500 w-1/3">Dung lượng</th>
                <td class="py-3 text-charcoal-900"><%= product.storageGb %>GB</td>
              </tr>
              <tr class="border-t border-charcoal-900/10">
                <th scope="row" class="py-3 text-left font-medium text-charcoal-500">Pin</th>
                <td class="py-3 text-charcoal-900"><%= product.batteryHealth %>%</td>
              </tr>
              <tr class="border-t border-charcoal-900/10">
                <th scope="row" class="py-3 text-left font-medium text-charcoal-500">Tình trạng ngoại hình</th>
                <td class="py-3 text-charcoal-900"><%= product.cosmeticCondition %></td>
              </tr>
              <tr class="border-t border-charcoal-900/10">
                <th scope="row" class="py-3 text-left font-medium text-charcoal-500">Màu sắc</th>
                <td class="py-3 text-charcoal-900"><%= product.color %></td>
              </tr>
              <% if (product.notes) { %>
              <tr class="border-t border-charcoal-900/10">
                <th scope="row" class="py-3 text-left font-medium text-charcoal-500">Ghi chú</th>
                <td class="py-3 text-charcoal-900"><%= product.notes %></td>
              </tr>
              <% } %>
            </tbody>
          </table>

          <div class="mt-8 rounded-2xl bg-charcoal-950 text-cream-50 p-5">
            <p class="text-sm font-semibold text-gold-400">Cam kết Xóm Táo</p>
            <p class="mt-1 text-sm text-cream-50/70"><%= siteConfig.slogan %></p>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href="<%= siteConfig.contact.zalo.url %>" target="_blank" rel="noopener noreferrer" class="btn-gold">Liên hệ Zalo</a>
            <a href="<%= siteConfig.contact.messenger.url %>" target="_blank" rel="noopener noreferrer" class="btn-outline">Nhắn Messenger</a>
            <a href="tel:<%= siteConfig.contact.hotline.phone %>" class="btn-dark">Gọi hotline</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
<%- include("partials/floating-contact") %>
<%- include("partials/scripts") %>
</body>
</html>
