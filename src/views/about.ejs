<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("partials/head") %>
</head>
<body>
<%- include("partials/header") %>

<main>
  <section class="bg-charcoal-950 text-cream-50 py-14 sm:py-20">
    <div class="container-max px-4 sm:px-6 lg:px-10 text-center">
      <span class="badge bg-gold-500/15 text-gold-400 mx-auto">Về chúng tôi</span>
      <h1 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold max-w-2xl mx-auto"><%= siteConfig.shopName %> — nơi chỉ bán máy zin</h1>
      <p class="mt-4 text-cream-50/70 max-w-xl mx-auto"><%= siteConfig.about.story %></p>
    </div>
  </section>

  <section class="section-pad bg-cream-50">
    <div class="container-max grid sm:grid-cols-3 gap-6">
      <div class="card p-6 text-center">
        <p class="text-3xl font-display font-extrabold text-gold-600"><%= siteConfig.about.founded %></p>
        <p class="mt-2 text-sm text-charcoal-500">Năm thành lập</p>
      </div>
      <div class="card p-6 text-center">
        <p class="text-sm font-semibold text-charcoal-900"><%= siteConfig.address %></p>
        <p class="mt-2 text-sm text-charcoal-500">Địa chỉ cửa hàng</p>
      </div>
      <div class="card p-6 text-center">
        <p class="text-sm font-semibold text-charcoal-900"><%= siteConfig.openingHours %></p>
        <p class="mt-2 text-sm text-charcoal-500">Giờ mở cửa</p>
      </div>
    </div>
  </section>

  <%- include("partials/trust-banner") %>

  <section class="section-pad bg-white">
    <div class="container-max max-w-3xl">
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-charcoal-950 text-center"><%= comparison.title %></h2>
      <p class="mt-2 text-center text-sm text-charcoal-500"><%= comparison.subtitle %></p>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-charcoal-900/10">
        <table class="w-full text-sm">
          <thead class="bg-charcoal-950 text-cream-50">
            <tr>
              <th scope="col" class="py-3 px-4 text-left font-medium">Tiêu chí</th>
              <th scope="col" class="py-3 px-4 text-left font-medium text-gold-400">Xóm Táo</th>
              <th scope="col" class="py-3 px-4 text-left font-medium">Nơi khác</th>
            </tr>
          </thead>
          <tbody>
            <% comparison.rows.forEach(function(row, i) { %>
            <tr class="<%= i % 2 === 0 ? 'bg-cream-50' : 'bg-white' %>">
              <td class="py-3 px-4 font-medium text-charcoal-900"><%= row.criteria %></td>
              <td class="py-3 px-4 font-semibold text-gold-600"><%= row.xomTao %></td>
              <td class="py-3 px-4 text-charcoal-500"><%= row.otherShops %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
<%- include("partials/floating-contact") %>
<%- include("partials/scripts") %>
</body>
</html>
