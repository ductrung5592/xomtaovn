<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("partials/head") %>
</head>
<body>
<%- include("partials/header") %>

<main>
  <article>
    <header class="bg-charcoal-950 text-cream-50 py-14 sm:py-20">
      <div class="container-max px-4 sm:px-6 lg:px-10 max-w-3xl">
        <nav class="text-xs text-cream-50/60" aria-label="Đường dẫn">
          <a href="/" class="hover:text-gold-400">Trang chủ</a> /
          <a href="/blog" class="hover:text-gold-400">Blog</a>
        </nav>
        <h1 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold"><%= post.title %></h1>
        <p class="mt-4 text-sm text-cream-50/70">
          <%= post.categoryLabel %> · Đăng ngày <time datetime="<%= post.date %>"><%= formatPostDate(post.date) %></time>
          <% if (post.updated !== post.date) { %>
            · Cập nhật <time datetime="<%= post.updated %>"><%= formatPostDate(post.updated) %></time>
          <% } %>
        </p>
      </div>
    </header>

    <div class="section-pad bg-cream-50">
      <div class="container-max max-w-3xl">
        <% if (post.image) { %>
          <img src="<%= post.image %>" alt="<%= post.imageAlt %>" class="mb-8 w-full rounded-2xl" />
        <% } %>

        <div class="blog-prose"><%- post.html %></div>

        <% if (post.faq.length > 0) { %>
          <section class="mt-12">
            <h2 class="font-display text-2xl font-extrabold text-charcoal-950">Câu hỏi thường gặp</h2>
            <div class="mt-5 space-y-4">
              <% post.faq.forEach(function(item) { %>
                <div class="card p-5">
                  <h3 class="font-display font-bold text-charcoal-950"><%= item.q %></h3>
                  <p class="mt-2 text-sm text-charcoal-700 leading-relaxed"><%= item.a %></p>
                </div>
              <% }); %>
            </div>
          </section>
        <% } %>

        <% if (post.sources.length > 0) { %>
          <section class="mt-12">
            <h2 class="font-display text-lg font-bold text-charcoal-950">Nguồn tham khảo</h2>
            <ul class="mt-3 space-y-1.5 text-sm">
              <% post.sources.forEach(function(source) { %>
                <li><a href="<%= source.url %>" target="_blank" rel="noopener noreferrer" class="text-gold-700 underline hover:text-gold-600"><%= source.title %></a></li>
              <% }); %>
            </ul>
          </section>
        <% } %>

        <div class="mt-12 rounded-2xl bg-charcoal-950 p-6 sm:p-8 text-center text-cream-50">
          <p class="font-display text-lg font-bold">Muốn xem máy thật, giá thật?</p>
          <p class="mt-2 text-sm text-cream-50/70"><%= siteConfig.address %> · <%= siteConfig.openingHours %></p>
          <div class="mt-5 flex flex-wrap justify-center gap-3">
            <a href="/san-pham" class="btn-gold">Xem máy đang có</a>
            <a href="<%= siteConfig.contact.zalo.url %>" target="_blank" rel="noopener noreferrer" class="btn-outline">Nhắn Zalo</a>
          </div>
        </div>
      </div>
    </div>
  </article>
</main>

<%- include("partials/footer") %>
<%- include("partials/floating-contact") %>
<%- include("partials/scripts") %>
</body>
</html>
