{
  "name": "xom-tao-iphone-store",
  "version": "1.0.0",
  "private": true,
  "description": "Website ban iPhone cao cap cho Xom Tao",
  "main": "src/app.js",
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"nodemon src/app.js\"",
    "build": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/styles.css --watch",
    "start": "node src/app.js",
    "validate:products": "node scripts/validate-products.js"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "data",
      "scripts",
      "package.json"
    ],
    "ext": "js,mjs,cjs,json,ejs"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4"
  }
}
